# Skopiuj do pliku .env i uzupełnij. Plik .env jest w .gitignore.
# Klucz potrzebny tylko dla modeli Claude (płatne API). Bez klucza aplikacja używa modelu lokalnego z Ollamy.
ANTHROPIC_API_KEY=

# Model domyślny: ollama:<nazwa> (lokalnie, za darmo) albo claude-haiku-5-5 / claude-sonnet-5-5
TRACKDAY_MODEL=ollama:qwen2.5:7b

# Ollama: adres serwera i okno kontekstu modelu lokalnego
OLLAMA_HOST=http://localhost:11434
TRACKDAY_OLLAMA_NUM_CTX=16384
# Poziom wysiłku modelu Claude: low | medium | high
TRACKDAY_EFFORT=low

# Ścieżka do bazy SQLite
TRACKDAY_DB_PATH=data/trackday.db
