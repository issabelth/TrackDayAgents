# Skopiuj do pliku .env i uzupełnij. Plik .env jest w .gitignore.
ANTHROPIC_API_KEY=sk-ant-...

# Model do ekstrakcji danych (tani model wystarcza - zob. dokument projektowy)
TRACKDAY_MODEL=claude-haiku-5-5
# Poziom wysiłku modelu: low | medium | high
TRACKDAY_EFFORT=low

# Ścieżka do bazy SQLite
TRACKDAY_DB_PATH=data/trackday.db
